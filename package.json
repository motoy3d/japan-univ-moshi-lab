{
  "name": "japan-univ-moshi-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "infra"
  ],
  "scripts": {
    "validate": "tsx scripts/validate-content.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm -w web run typecheck && npm -w infra run typecheck",
    "dev:api": "tsx watch api/src/local-server.ts",
    "dev:web": "npm -w web run dev",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run validate && npm -w web run build && tsx scripts/check-bundle.ts",
    "deploy": "npm run build && npm -w infra run deploy",
    "e2e": "playwright test --trace off"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1175.0",
    "@aws-sdk/client-dynamodb": "^3.1175.0",
    "@aws-sdk/client-lambda": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-secrets-manager": "^3.1175.0",
    "@aws-sdk/lib-dynamodb": "^3.1175.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "zod": "^4.6.7"
  }
}
